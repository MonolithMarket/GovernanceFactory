# Sepolia RPC endpoint used with forge script --rpc-url.
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# Testnet-only deployer key. Never commit a funded production key.
PRIVATE_KEY=

# DeployCoinDAOFactory.s.sol
MONOLITH_BENEFICIARY=

# DeployCoinDAO.s.sol (output from the factory deployment)
COIN_DAO_FACTORY=

# Optional CoinDAO overrides
# Must be a bytes32 value. Use a unique salt for each launch.
# COIN_DAO_SALT=0x72b276a1dd5b710621574207b858cc63fba3bb15454251b280a4197394a6c50e
DEPLOYER_STAKE_BPS=0
DEPLOYER_RECIPIENT=0x0000000000000000000000000000000000000000
STAKING_TOKEN=COIN

# Optional Monolith market overrides
COLLATERAL_FACTOR=5000
MIN_DEBT=1000000000000000000000
TIME_UNTIL_IMMUTABILITY=31536000
HALF_LIFE=604800
TARGET_FREE_DEBT_RATIO_START_BPS=2000
TARGET_FREE_DEBT_RATIO_END_BPS=4000
REDEEM_FEE_BPS=30
STALENESS_THRESHOLD=172800
MAX_BORROW_DELTA_BPS=50
